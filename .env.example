# Server Configuration
PROJECT_NAME="CareerPath AI"
ENV=development
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database & Redis
DATABASE_URL=postgresql://careerpath:careerpath_secret@localhost:5432/careerpath_db
REDIS_URL=redis://localhost:6379/0

# LLM & AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Public Data APIs
EMPLOYMENT24_API_KEY=your_employment24_api_key_here
QNET_API_KEY=your_qnet_api_key_here
PUBLIC_DATA_PORTAL_KEY=your_public_data_portal_key_here

# Security & JWT
SECRET_KEY=generate_a_secure_random_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
